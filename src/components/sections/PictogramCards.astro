---
import SectionHead from '../SectionHead.astro';
import Pictogram from '../Pictogram.astro';
import Icon from '../Icon.astro';
import { tr } from '../../lib/i18n';
import { pageExists, pageHref } from '../../lib/pages';
interface Props { lang: string; section: any }
const { lang, section: s } = Astro.props;
---
<section class="section" id={s.id}>
  <div class="container">
    <SectionHead lang={lang} eyebrow={s.eyebrow} heading={s.heading} intro={s.intro} />
    <ul class:list={['arch-grid', `arch-grid--${Math.min(s.items.length, 4)}`]} data-reveal-group>
      {s.items.map((item: any) => (
        <li class="arch-card arch-card--picto" data-reveal>
          <span class="arch-card-picto"><Pictogram name={item.pictogram} size={34} /></span>
          <h3 class="arch-card-title">{tr(item.title, lang)}</h3>
          <p>{tr(item.text, lang)}</p>
          {item.link && pageExists(item.link.page) && (
            <a class="text-link" href={pageHref(lang, item.link.page)}>{tr(item.link.label, lang)} <Icon name="arrow-right" size={15} directional /></a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
