---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { feasts, services, site } from '../../lib/content';
import { getLanguage, t, tr } from '../../lib/i18n';
import { pageExists, pageHref } from '../../lib/pages';
import { nowIn } from '../../lib/calendar';
import { occurrences } from '../../lib/schedule';
import { weekPreview } from '../../lib/views';
interface Props { lang: string; section: any }
const { lang, section: s } = Astro.props;
const L = getLanguage(lang);
const now = nowIn(site.timeZone);
const days = s.days ?? 7;
const occ = occurrences(now.day, now.day + days - 1, services, feasts, site.calendar);
const fmt = { lang, locale: L.locale, hourCycle: L.hourCycle, t: (k: string, v?: any) => t(k, lang, v), tr: (v: any) => tr(v, lang) };
---
<section class="section section--muted" id={s.id}>
  <div class="container">
    <SectionHead lang={lang} heading={s.heading} intro={s.intro}>
      {pageExists('services') && <a class="text-link" href={pageHref(lang, 'services')}>{t('fullSchedule', lang)} <Icon name="arrow-right" size={15} directional /></a>}
    </SectionHead>
    <ol class="week-strip" data-week-preview data-days={days} data-reveal set:html={weekPreview(now.day, days, occ, now.day, fmt)} />
  </div>
</section>
<script>
  import { nowIn } from '../../lib/calendar';
  import { ctx, readJson, t, tr } from '../../lib/client';
  import { occurrences } from '../../lib/schedule';
  import { weekPreview } from '../../lib/views';
  document.querySelectorAll<HTMLElement>('[data-week-preview]').forEach((el) => {
    const c = ctx();
    const data = readJson('kiot-schedule');
    const days = Number(el.dataset.days) || 7;
    const now = nowIn(c.timeZone);
    const occ = occurrences(now.day, now.day + days - 1, data, data.feasts, c.calendar);
    el.innerHTML = weekPreview(now.day, days, occ, now.day, { lang: c.lang, locale: c.locale, hourCycle: c.hourCycle, t, tr });
  });
</script>
