---
import Cross from './Cross.astro';
import { site, type LogoStyle } from '../lib/content';
import { asset, tr } from '../lib/i18n';
import { crossShapes } from '../lib/cross';

interface Props {
  lang: string;
  inverse?: boolean;
  showName?: boolean;
  class?: string;
}
const { lang, inverse = false, showName = true, class: cls = '' } = Astro.props;
const style: LogoStyle = site.logo?.style ?? 'kiot';
const name = tr(site.name, lang);
const short = tr(site.shortName, lang);
const sealText = tr(site.logo?.sealText ?? site.name, lang).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase();
const alt = tr(site.logo?.alt, lang);
const uid = `seal-${lang}-${inverse ? 'i' : 'n'}`;
---
<span class:list={['logo', `logo--${style}`, { 'logo--inverse': inverse }, cls]}>
  {style === 'kiot' && (
    /* Simplified kiot mark: arched shrine + large Byzantine cross — readable at ~40px. */
    <svg class="logo-mark" viewBox="0 0 48 60" aria-hidden="true">
      <defs>
        <linearGradient id={`gl-${uid}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#9c7124" />
          <stop offset=".3" stop-color="#ecd38f" />
          <stop offset=".55" stop-color="#b48632" />
          <stop offset=".8" stop-color="#f1dc9f" />
          <stop offset="1" stop-color="#a87a2a" />
        </linearGradient>
      </defs>
      <path d="M3 59V23a21 21 0 0 1 42 0v36Z" fill={`url(#gl-${uid})`} />
      <path d="M7 55.5V23.5a17 17 0 0 1 34 0v32Z" fill="#561524" />
      <g transform="translate(24 36) scale(.3)" fill={`url(#gl-${uid})`}>
        <Fragment set:html={crossShapes(false)} />
      </g>
    </svg>
  )}
  {style === 'seal' && (
    <svg class="logo-mark logo-mark--round" viewBox="0 0 100 100" aria-hidden="true">
      <defs><path id={uid} d="M50 50 m-36 0 a36 36 0 1 1 72 0 a36 36 0 1 1 -72 0" /></defs>
      <circle cx="50" cy="50" r="48" fill="#561524" />
      <circle cx="50" cy="50" r="46" fill="none" stroke="#c29a46" stroke-width="2" />
      <circle cx="50" cy="50" r="27" fill="none" stroke="#c29a46" stroke-width="1.2" />
      <text font-size="8.4" fill="#e6cd8c" font-family="var(--font-display)" letter-spacing="1.6">
        <textPath href={`#${uid}`} startOffset="50%" text-anchor="middle">{sealText}</textPath>
      </text>
      <g transform="translate(50 50) scale(.42)" fill="#e6cd8c">
        <Fragment set:html={crossShapes()} />
      </g>
    </svg>
  )}
  {style === 'square' && <img class="logo-mark logo-mark--square" src={asset(site.logo?.image)} alt={showName ? '' : alt} width="48" height="48" />}
  {style === 'wordmark' && <Cross lang={lang} size={18} class="logo-wordmark-cross" />}
  {showName && (
    <span class="logo-text">
      <span class="logo-name">{name}</span>
      {short && short !== name && <span class="logo-short" aria-hidden="true">{short}</span>}
    </span>
  )}
</span>
