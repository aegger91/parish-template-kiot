{
  "name": "parish-template-kiot",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4327",
    "build": "node scripts/validate-content.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4328",
    "validate": "node scripts/validate-content.mjs",
    "check:layout": "node scripts/check-layout.mjs http://127.0.0.1:4328",
    "screenshots": "node scripts/screenshots.mjs http://127.0.0.1:4328 screenshots",
    "illustrations": "node scripts/build-illustrations.mjs",
    "zip": "rm -f parish-template-kiot-dist.zip && cd dist && zip -qr ../parish-template-kiot-dist.zip .",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/gfs-didot": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "lucide-static": "^1.78.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.65.1"
  }
}
