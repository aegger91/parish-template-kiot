      "label": {
        "en": "At the Divine Liturgy",
        "el": "Στη Θεία Λειτουργία"
      },
      "description": {
        "en": "Names are read aloud during the litanies.",
        "el": "Τα ονόματα διαβάζονται στις δεήσεις."
      }
    },
    {
      "id": "moleben",
      "appliesTo": [
        "health"
      ],
      "suggested": 10,
      "label": {
        "en": "Moleben (Paraklesis)",
        "el": "Παράκληση"
      },
      "description": {
        "en": "Names are read at the next prayer service.",
        "el": "Τα ονόματα διαβάζονται στην επόμενη Παράκληση."
      }
    },
    {
      "id": "panikhida",
      "appliesTo": [
        "repose"
      ],
      "suggested": 10,
      "label": {
        "en": "Panikhida (Trisagion)",
        "el": "Τρισάγιο"
      },
      "description": {
        "en": "Names are read at the next memorial service.",
        "el": "Τα ονόματα διαβάζονται στο επόμενο Τρισάγιο."
      }
    },
    {
      "id": "sorokoust",
      "appliesTo": [
        "health",
        "repose"
      ],
      "suggested": 40,
      "label": {
        "en": "Sorokoust (40 days)",
        "el": "Σαρανταλείτουργο (40 ημέρες)"
      },
      "description": {
        "en": "Names are remembered at forty Liturgies in a row.",
        "el": "Τα ονόματα μνημονεύονται σε σαράντα συνεχόμενες Λειτουργίες."
