  "commemorations": [
    {
      "id": "proskomedia",
      "appliesTo": [
        "health",
        "repose"
      ],
      "suggested": 5,
      "label": {
        "en": "Proskomide",
        "el": "Προσκομιδή"
      },
      "description": {
        "en": "A particle is taken from the prosphora for each name before the Liturgy.",
        "el": "Για κάθε όνομα αφαιρείται μερίδα από το πρόσφορο πριν από τη Λειτουργία."
      }
    },
    {
      "id": "liturgy",
      "appliesTo": [
        "health",
        "repose"
      ],
