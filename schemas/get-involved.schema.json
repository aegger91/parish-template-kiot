{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get-involved.schema.json",
  "title": "Get Involved",
  "description": "Events and volunteer needs. In production these are read from OrthodoxConnect; this file is the sample and offline fallback.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "source": {
      "const": "orthodoxconnect"
    },
    "eventCategories": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/labelled"
      }
    },
    "needCategories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "icon": {
            "$ref": "common.schema.json#/$defs/icon"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "time": {
            "$ref": "common.schema.json#/$defs/time"
          },
          "location": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "signups": {
            "type": "integer",
            "minimum": 0
          },
          "organizer": {
            "type": "string"
          },
          "category": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/localized"
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "time",
          "location",
          "capacity",
          "signups",
          "organizer",
          "category"
        ],
        "additionalProperties": false
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "time": {
            "$ref": "common.schema.json#/$defs/time"
          },
          "location": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "signups": {
            "type": "integer",
            "minimum": 0
          },
          "organizer": {
            "type": "string"
          },
          "category": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/localized"
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "time",
          "location",
          "capacity",
          "signups",
          "organizer",
          "category"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "events",
    "needs"
  ],
  "additionalProperties": false
}