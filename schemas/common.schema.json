{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable id. Never change it once published; other content and OrthodoxConnect refer to it."
    },
    "localized": {
      "description": "Text in one or more languages, keyed by language code. Missing languages fall back to the default language.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Za-z0-9]+)?$": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    },
    "localizedList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localized"
      },
      "description": "Paragraphs."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "description": "24-hour HH:MM, parish time zone"
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "description": "Site-relative path to a file in public/."
    },
    "url": {
      "type": "string",
      "pattern": "^(https?://|$)"
    },
    "pictogram": {
      "enum": [
        "church",
        "chalice",
        "censer",
        "candle",
        "prayer-rope",
        "gospel",
        "icon-frame",
        "bells",
        "cross"
      ],
      "description": "Orthodox pictogram from the shared set."
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name for everyday, non-religious meaning (for example coffee, music)."
    },
    "pageLink": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/localized"
        }
      },
      "required": [
        "page"
      ],
      "additionalProperties": false
    },
    "labelled": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/localized"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "money": {
      "type": "number",
      "minimum": 0,
      "description": "Amount in major currency units (dollars), see site.currency."
    }
  }
}