{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news.schema.json",
  "title": "News",
  "description": "News articles.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/labelled"
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "slug": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "category": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "image": {
            "type": "string"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "excerpt": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "body": {
            "$ref": "common.schema.json#/$defs/localizedList"
          }
        },
        "required": [
          "id",
          "slug",
          "date",
          "category",
          "title",
          "excerpt",
          "body"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "categories",
    "articles"
  ],
  "additionalProperties": false
}